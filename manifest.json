{
  "name": "Chingola Mining Monitor - AI Detection System",
  "short_name": "Mining Monitor",
  "description": "Progressive Web App for AI-powered illegal mining detection in Chingola District, Zambia. Features real-time satellite analysis, change detection, and field reporting.",
